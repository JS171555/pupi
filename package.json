  "type": "module",
  "bugs": {
    "url": "https://github.com/JS171555/pupi/issues"
  },
  "homepage": "https://github.com/JS171555/pupi#readme",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.56.1",
    "supabase": "2.83.0",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=24"
  }
