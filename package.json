{
  "name": "pupi",
  "version": "0.3.0",
  "description": "Fundação modular do e-commerce petshop Pupi",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "db:test": "node --test --test-isolation=none tests/database/*.test.js",
    "check": "npm test && npm run db:test",
    "verify:remote": "node --env-file-if-exists=.env scripts/verify-connection.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "design:generate": "node scripts/design-tokens.js",
    "design:check": "node scripts/design-tokens.js --check",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JS171555/pupi.git"
  },
